# Copy to .env and fill in the key for your chosen provider.
# Set LLM_PROVIDER to one of: anthropic (default), groq, glm.

LLM_PROVIDER=glm

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (free tier) — https://console.groq.com/   (OpenAI-compatible)
GROQ_API_KEY=

# GLM via Z.ai — https://z.ai/   (OpenAI-compatible, model glm-4.6)
ZAI_API_KEY=

# --- Assignment 2 ---------------------------------------------------------

# Tracing (§2.1). LangFuse Cloud free tier: create a project, then
# Settings > API Keys. Leave blank to run untraced — tracing degrades to a
# no-op so CI and offline runs still work.
# Self-hosting instead? Only LANGFUSE_HOST changes (e.g. http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Embeddings for the pgvector retriever (§2.6.2). text-embedding-3-small, 1536-dim.
OPENAI_API_KEY=

# Retrieval backend: bm25 (local, no DB — Assignment 1 default) or pgvector.
# The deployed agent runs pgvector; bm25 keeps local dev and CI working without
# a database.
RETRIEVAL_BACKEND=bm25

# Postgres + pgvector. Local dev via docker:
#   docker run -d --name pgvector -p 5432:5432 -e POSTGRES_PASSWORD=postgres \
#     pgvector/pgvector:pg17
# In AWS this is the RDS endpoint, injected into the ECS task.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
